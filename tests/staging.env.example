# Settings for tests/staging/run-staging-tests.sh. Copy to tests/staging.env (gitignored) and fill in.
# Format: KEY=VALUE, parsed like the other config files. Relative paths are relative to the repo.
#
# The test talks to Let's Encrypt staging, Hetzner DNS and the devices below. It reboots the
# devices several times and leaves them serving a staging certificate.

# Contact address for the staging account. Let's Encrypt refuses example.com addresses.
ACME_EMAIL=

# File with the Hetzner Cloud API token on one line (write access to the zone of the domains below).
HETZNER_API_TOKEN_FILE=secrets/hetzner.token

# Optional. Defaults: 1.1.1.1:53,9.9.9.9:53, ec256 and 120.
#DNS_RESOLVERS=1.1.1.1:53,9.9.9.9:53
#KEY_TYPE=ec256
#REBOOT_TIMEOUT=120

# Optional. yes = allow HTTPS without certificate check for the deploy (see config/shelly-certs.conf.example).
#ALLOW_INSECURE_DEPLOY=no

# First device (required). DOMAINS: space-separated, the first one is the certificate name.
DEVICE1_DOMAINS=
DEVICE1_ADDRESS=
# Optional: file with the device password on its first line.
#DEVICE1_PASSWORD_FILE=

# Second device (optional, must be another physical device). Used to check that adding a device
# gets only that device a certificate and leaves the first one alone, and for prune.
#DEVICE2_DOMAINS=
#DEVICE2_ADDRESS=
#DEVICE2_PASSWORD_FILE=
