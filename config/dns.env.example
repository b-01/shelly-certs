# Credentials for the lego DNS provider. Copy to secrets/dns.env (mode 600).
# lego reads this file itself (--env-file), so the token never goes through shelly-certs.
#
# Preferred: point lego at a file holding only the token. Then the environment only ever holds a
# path. Create secrets/hetzner.token (mode 600) with the Hetzner Cloud API token on one line.
# Relative paths are relative to the tool folder.
HETZNER_API_TOKEN_FILE=secrets/hetzner.token
#
# Alternative: the token directly in this file.
#HETZNER_API_TOKEN=your-token
